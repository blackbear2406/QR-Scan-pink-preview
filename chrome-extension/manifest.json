{
  "manifest_version": 3,
  "name": "ECG Panther",
  "version": "1.1.2",
  "description": "Tự động thêm nút Quét mã QR trong cửa sổ đọc điện tim trên VNPT-HIS.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://bvdongthap.vncare.vn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "ECG Panther – Quét mã QR"
  },
  "host_permissions": [
    "https://bvdongthap.vncare.vn/*"
  ]
}
